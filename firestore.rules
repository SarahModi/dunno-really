rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isStaff() {
      return isAuthenticated() && 
        (request.auth.token.role == 'staff' || 
         request.auth.token.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['staff', 'admin']);
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if isOwner(userId) || isStaff();
    }

    // Cloud kitchen menu items - publicly readable, writable by staff
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if true; // allow kitchen updates & seeding
    }

    // Live customer orders
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isStaff();
    }

    // PG Flatmate group orders
    match /group_sessions/{roomId} {
      allow read, write: if true;
    }

    // Daily tiffin subscriptions
    match /subscriptions/{subId} {
      allow read, write: if true;
    }

    // Neighborhood societies and PG zones
    match /societies/{societyId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
